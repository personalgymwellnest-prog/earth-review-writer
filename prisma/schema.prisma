generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model ReviewSubmission {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  service      String   @default("gym") // "gym" | "pilates"
  audiences    String   @default("[]") // JSON-encoded string array ("おすすめしたい方")
  course       String? // no longer asked; kept for old rows
  reasons      String // JSON-encoded string array
  highlights   String // JSON-encoded string array
  trainerName  String?
  impression   String?
  rating       Int
  note         String?

  drafts        String // JSON-encoded string array of the 3 generated drafts
  chosenDraft   String? // the draft text the customer actually picked/edited
  postedToGoogle Boolean @default(false)

  @@index([createdAt])
}
